# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
# Backend: "mock" (demo store in the browser) or "supabase"
VITE_BACKEND=mock
# Show the "try without an account" buttons on the login page (set to false in production)
VITE_DEMO=true
# Supabase project (public values — the anon key is safe in the browser; the service key must NEVER be here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
